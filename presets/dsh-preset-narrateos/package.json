{
    "name": "@narrateos/dsh-preset-narrateos",
    "version": "0.1.0",
    "private": true,
    "description": "NarrateOS 通用长篇小说多智能体创作模式预设包（Bundle Patch、外部化角色配置与开书构思 Skill）",
    "type": "module",
    "exports": {
        "./cordis.patch.yml": "./cordis.patch.yml",
        "./roles/*": "./roles/*",
        "./skills/*": "./skills/*",
        "./locale/*.json": "./locale/*.json",
        "./package.json": "./package.json"
    },
    "files": [
        "cordis.patch.yml",
        "roles",
        "skills",
        "locale/*.json",
        "README.md"
    ],
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        }
    },
    "scripts": {
        "test": "pnpm --filter @narrateos/dsh-preset-narrateos... run build && pnpm run test:built",
        "test:built": "node --test tests/preset.test.mjs"
    },
    "peerDependencies": {
        "@deepseek-ai/dsh-agent-preset": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-persona": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-tool-fs": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-tool-fs-search": "^0.2.2-rc.1",
        "@deepseek-ai/dsh-tool-web": "^0.2.2-rc.1",
        "@narrateos/dsh-book-store": "workspace:*",
        "@narrateos/dsh-book-tools": "workspace:*",
        "@narrateos/dsh-pipeline": "workspace:*",
        "@narrateos/dsh-client-ui-studio": "workspace:*",
        "@narrateos/dsh-client-ui-theme-narrateos": "workspace:*",
        "@deepseek-ai/dsh-agent-preset-registry": "^0.2.2-rc.1"
    }
}
