{
    "name": "@narrateos/dsh-pipeline",
    "version": "0.1.0",
    "private": true,
    "description": "NarrateOS 纯 Host 后端管线服务：外部化角色配置、双路径 RoleRunner、单章闭环、Sync、多轮 Dreaming、三级自愈、换卷交接、REST/SSE 与斜杠命令",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./locale/*.json": "./locale/*.json",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "locale/*.json",
        "package.json"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run --root ../.. packages/dsh-pipeline"
    },
    "dependencies": {
        "@deepseek-ai/schemastery": "~3.19.0",
        "@narrateos/dsh-book-store": "workspace:*",
        "@narrateos/dsh-book-tools": "workspace:*",
        "yaml": "^2.7.0",
        "zod": "^3.24.0"
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": "~4.1.0",
        "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
        "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
        "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
        "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
        "@deepseek-ai/dsh-session": "0.2.2-rc.1",
        "@deepseek-ai/dsh-skill": "0.2.2-rc.1",
        "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
        "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
    }
}
