{
    "name": "@narrateos/dsh-client-ui-studio",
    "version": "0.1.0",
    "private": true,
    "description": "NarrateOS Operator Studio 纯浏览器前端工作台与节点实时/历史会话轨迹钻取插件",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./client": {
            "default": "./dist/client.js"
        },
        "./locale/*.json": "./locale/*.json",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "locale/*.json",
        "package.json"
    ],
    "dsh": {
        "client": {
            "platform": "web",
            "inject": [
                "@deepseek-ai/dsh-client-ui-layout",
                "@deepseek-ai/dsh-client-ui-sidebar"
            ]
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/bundle-client.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
        "test": "vitest run --root ../.. packages/dsh-client-ui-studio"
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": "~4.1.0"
    },
    "devDependencies": {
        "jsdom": "^26.1.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    }
}
