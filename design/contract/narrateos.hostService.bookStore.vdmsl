-- 作品资产与运行状态存储引擎这个盒子：定稿章节手稿、随正文保存的终审节拍与伏笔确认，以及派生状态结案记录。
-- 只写每个端口在数据上的前后条件；两阶段提交与崩溃恢复之间的先后由 design/behavior 持有。
-- 精度停在“正文与确认同批落盘、派生状态重用已保存确认结案、存在未结案半章时禁止跨越提交新章”：正文文本、角色字段与检索打分保持不透明。
module narrateos_hostService_bookStore
exports
  types
    ChapterId; Confirmation
  operations
    commitManuscript : ChapterId * Confirmation ==> ();
    settleDerivedState : ChapterId * Confirmation ==> ()
definitions
types
  ChapterId = token;
  Confirmation = token;

-- REQ-2
-- REQ-9
-- REQ-10
-- 已定稿落盘的章节手稿、随正文同批保存的终审节拍伏笔确认，以及已完成派生状态与节拍伏笔核销结案的章节。
state Ledger of
  manuscripts   : set of ChapterId
  confirmations : map ChapterId to Confirmation
  settled       : set of ChapterId
inv mk_Ledger(ms, cfs, stl) ==
  dom cfs = ms and stl subset ms
init s == s = mk_Ledger({}, {|->}, {})
end

operations
  -- REQ-2
  -- REQ-9
  -- REQ-10
  -- 阶段一原子提交：仅在不存在未结案半章时归档定稿正文，并同批持久化终审确认的节拍与伏笔；每章正文至多定稿落盘一次。
  commitManuscript(ch : ChapterId, cf : Confirmation)
  ext rd settled
      wr manuscripts, confirmations
  pre ch not in set manuscripts and manuscripts = settled
  post manuscripts = manuscripts~ union {ch} and
       confirmations = confirmations~ munion {ch |-> cf};

  -- REQ-2
  -- REQ-9
  -- REQ-10
  -- 阶段二原子提交：重用随该章正文持久化保存的终审确认提交派生状态与节拍伏笔核销；每章派生状态至多结案一次。
  settleDerivedState(ch : ChapterId, cf : Confirmation)
  ext rd manuscripts, confirmations
      wr settled
  pre ch in set manuscripts and ch not in set settled and
      confirmations(ch) = cf
  post settled = settled~ union {ch};

end narrateos_hostService_bookStore
