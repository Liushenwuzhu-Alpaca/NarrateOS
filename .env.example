# NarrateOS 运行时环境与模型路由配置模板
# 复制本文件为 .env 后填入实际配置（.env 已被 .gitignore 忽略，严禁提交）

# ==================== 1. 模型鉴权与网关（环境敏感，仅放 .env） ====================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ==================== 2. 异构三池模型路由（按需切换，不写死在代码） ====================
# 强创作模型池：用于 Planner 细纲、Writer 正文执笔、局部 Patch、开书编译
NARRATEOS_MODEL_STRONG=deepseek-v4-pro
# 弱模型/快检索模型池：用于 Librarian 目录检索、Extractor 状态抽取、Sync 差异判定
NARRATEOS_MODEL_FAST=deepseek-flash
# 审校/盲审模型池：用于 FactChecker 字面核查、同人 T0 异构盲审（建议与强创作异构）
NARRATEOS_MODEL_AUDIT=deepseek-flash

# ==================== 3. 超时与宿主调度接缝（可选） ====================
# 流式空闲看门狗毫秒数（借鉴 DSH idleWatchdog：连续无新分片超该时间才断开，默认 60000ms）
NARRATEOS_STREAM_IDLE_TIMEOUT_MS=60000
# 单次 LLM HTTP 请求总超时兜底毫秒数（可选，默认 120000ms，设为 0 则仅依赖空闲看门狗）
NARRATEOS_REQUEST_TIMEOUT_MS=120000
# 若通过 @deepseek-ai/dsh-llm 或自定义调度器运行，可指定模块路径
# NARRATEOS_DSH_LLM_MODULE=@deepseek-ai/dsh-llm
