# NarrateOS 运行时环境与模型路由配置模板
# 复制本文件为 .env 后填入实际配置（.env 已被 .gitignore 忽略，严禁提交）

# ==================== 1. 模型鉴权与网关（环境敏感，仅放 .env） ====================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ==================== 2. 强弱双池模型路由（按需切换，不写死在代码） ====================
# 强创作模型池：用于 Planner 细纲、Writer 正文执笔、局部 Patch、开书编译
NARRATEOS_MODEL_STRONG=deepseek-v4-pro
# 弱模型/快检索模型池：用于 Librarian 目录检索、Extractor 状态抽取、Sync 差异判定
NARRATEOS_MODEL_FAST=deepseek-flash
# 可分别指定宿主已注册的提供方，也可使用 provider:model。
# NARRATEOS_PROVIDER_STRONG=deepseek-official
# NARRATEOS_PROVIDER_FAST=deepseek-official
# 审校角色按角色路由选池；超时和 LLM 服务由宿主管理。
